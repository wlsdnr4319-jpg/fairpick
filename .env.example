# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env 는 커밋하지 않는다.
#   copy .env.example .env

# ---- MySQL (docker-compose db 서비스) ----
DB_USER=fairpick
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_PORT=3308

# ---- API ----
# 로컬 개발: 호스트에서 uvicorn 을 띄울 때는 localhost, docker compose 안에서는 db
DATABASE_URL=mysql+pymysql://fairpick:change-me@localhost:3308/fairpick?charset=utf8mb4

# openssl rand -hex 32 로 생성
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# 재발급 응답이 끊겨 이전 토큰이 다시 와도 이 시간(초) 안이면 탈취로 보지 않는다 (docs/troubleshooting.md 17)
REFRESH_REUSE_GRACE_SECONDS=30
# 운영(HTTPS)에서는 true
COOKIE_SECURE=false

# 스케줄과 날짜 계산 기준
APP_TZ=Asia/Seoul

# 프론트 개발 서버 주소 (CORS 허용). Vite 프록시를 쓰면 없어도 된다
CORS_ORIGINS=http://localhost:5173

# ---- 수집 (6주차) ----
CRAWL_USER_AGENT=FairPickBot/1.0 (+contact@example.com)

# ---- 알림 메일 (2단계) ----
# 비워 두면 실제로 보내지 않고 로그만 남긴다. 개발에서 메일 화면을 보려면 Mailpit:
#   docker compose --profile mail up -d mailpit  → http://localhost:8025
#   SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=페어픽 <no-reply@example.com>
# 메일 속 링크의 기준 주소 (프론트 주소). 운영에서는 https://도메인
APP_BASE_URL=http://localhost:5173

# 소셜 로그인 (선택). 비워 두면 그 로그인 버튼이 보이지 않는다. 발급 방법: docs/social-login.md
# 콘솔에 등록할 Redirect URI: {APP_BASE_URL}/api/v1/auth/oauth/kakao/callback (구글은 .../google/callback)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 웹 푸시 (선택). 비워 두면 브라우저 알림 설정이 보이지 않는다. 키 만들기: cd backend && python -m app.scripts.gen_vapid
# 한 번 만들면 바꾸지 않는다 (바꾸면 모든 기기가 다시 구독해야 함). 비밀 키는 저장소에 올리지 않는다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
